<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RespBench</RootNamespace>
    <AssemblyName>resp-bench-csharp</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>Ilia Kolominsky</Authors>
    <Description>C# benchmark engine for resp-bench - RESP protocol benchmark suite</Description>
    <!-- Publish as self-contained single file -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Redis/Valkey client drivers -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- valkey-glide-csharp - uncomment when available on NuGet -->
    <!-- <PackageReference Include="Valkey.Glide" Version="1.0.0" /> -->

    <!-- CLI argument parsing -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />

    <!-- HDR Histogram for latency measurement -->
    <PackageReference Include="HdrHistogram" Version="2.5.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

</Project>
