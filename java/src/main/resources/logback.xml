<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Benchmark application logging -->
    <logger name="io.valkey.javabenchmark" level="INFO"/>
    
    <!-- Suppress verbose DEBUG logs from Redisson and its dependencies -->
    <logger name="org.redisson" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>
    
    <!-- Suppress verbose logs from other drivers if needed -->
    <logger name="io.lettuce" level="WARN"/>
    <logger name="glide" level="WARN"/>
    
    <!-- Root level -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>