# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# Core dependencies
gem "redis", "~> 5.0"           # redis-rb client
gem "HDRHistogram", "~> 0.1"    # HdrHistogram for latency metrics
gem "oj", "~> 3.16"             # Fast JSON serialization
gem "concurrent-ruby", "~> 1.2" # Thread-safe data structures

gem "valkey", github: "valkey-io/valkey-glide-ruby", branch: "main"  # valkey-glide-ruby client (drop-in replacement for redis-rb)

group :development, :test do
  gem "minitest", "~> 5.0"
  gem "rake", "~> 13.0"
  gem "rubocop", "~> 1.50"
end
