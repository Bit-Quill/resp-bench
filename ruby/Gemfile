# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# Core dependencies
gem "redis", "~> 5.0"           # redis-rb client
gem "HDRHistogram", "~> 0.1"    # HdrHistogram for latency metrics
gem "oj", "~> 3.16"             # Fast JSON serialization
gem "concurrent-ruby", "~> 1.2" # Thread-safe data structures

# valkey-glide-ruby client; supplies the `Valkey` class via `require "valkey"`.
# Keep the default reproducible while allowing the AWS runner to benchmark the
# Ruby release that triggered the run.
gem "valkey-glide-rb", ENV.fetch("VALKEY_GLIDE_RUBY_VERSION", "1.0.0")

group :development, :test do
  gem "minitest", "~> 5.0"
  gem "rake", "~> 13.0"
  gem "rubocop", "~> 1.50"
end
